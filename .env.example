SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-only
OLUNE_SECRET=generate-an-independent-random-secret-with-at-least-32-characters
NODE_ENV=production
PORT=8080

# Integração central (somente servidor; opcional até a chave ser provisionada)
OLUNE_AI_PROVIDER=gemini
OLUNE_AI_MODEL=gemini-2.5-flash
OLUNE_AI_API_KEY=
OLUNE_AI_ENABLED=true
# Pacote de execução no Railway para mensagens de voz
RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg

# Teste grátis e planos (server/billing.js)
# Dias de teste para empresas novas (padrão 7). Empresas antigas ganham o teste a partir do primeiro acesso.
OLUNE_TRIAL_DAYS=7
# Ativação manual até o pagamento online: CPF/CNPJ:pago-até, separados por vírgula.
OLUNE_PAID_COMPANIES=
# WhatsApp de vendas (só números, com DDI) aberto pelo botão "Continuar com o plano".
OLUNE_SALES_WHATSAPP=
# "off" desliga o bloqueio de somente leitura (emergência).
OLUNE_BILLING=on
